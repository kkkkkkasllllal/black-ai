[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scenes/boot/Boot.gd" id="1_boot"]

[node name="Boot" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_boot")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.05, 0.05, 0.06, 1)

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 32
theme_override_constants/margin_bottom = 24

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="SummaryLabel" type="RichTextLabel" parent="Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3
size_flags_stretch_ratio = 2.0
bbcode_enabled = true
fit_content = false

[node name="Buttons" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="EnterExploreButton" type="Button" parent="Margin/VBox/Buttons"]
layout_mode = 2
text = "▶ 进入探索原型（M2–M4 圣坛·对话·送显卡）"

[node name="TestGpuButton" type="Button" parent="Margin/VBox/Buttons"]
layout_mode = 2
text = "测试 580 矿卡送礼规则"

[node name="TestContextButton" type="Button" parent="Margin/VBox/Buttons"]
layout_mode = 2
text = "切换上下文溢出 / PSU 清理缓存"

[node name="TestSlButton" type="Button" parent="Margin/VBox/Buttons"]
layout_mode = 2
text = "测试存档与跨存档 SL 计数"

[node name="LogLabel" type="RichTextLabel" parent="Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3
scroll_following = true

[connection signal="pressed" from="Margin/VBox/Buttons/EnterExploreButton" to="." method="_on_enter_explore_button_pressed"]
[connection signal="pressed" from="Margin/VBox/Buttons/TestGpuButton" to="." method="_on_test_gpu_button_pressed"]
[connection signal="pressed" from="Margin/VBox/Buttons/TestContextButton" to="." method="_on_test_context_button_pressed"]
[connection signal="pressed" from="Margin/VBox/Buttons/TestSlButton" to="." method="_on_test_sl_button_pressed"]
